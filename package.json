{
  "name": "peekaboo-events",
  "version": "1.0.0",
  "description": "Non-blocking React analytics hook powered by sendBeacon",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "keywords": [
    "react",
    "analytics",
    "hook",
    "event-tracking"
  ],
  "author": "Simranjeet Singh",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prebuild": "rimraf dist",
    "build": "node build.js",
    "build:types": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "cd examples && vite",
    "demo:build": "cd examples && vite build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^6.2.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ua-parser-js": "^2.0.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
