{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ES2022",
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
